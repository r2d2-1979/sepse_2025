            </ScreenAreas>
            <BlockPairName>EliteSafeZone</BlockPairName>
            <EdgeType>Light</EdgeType>
            <MirroringY>Z</MirroringY>
            <BuildTimeSeconds>320</BuildTimeSeconds>
            <DamageEffectName>Damage_Electrical_Damaged</DamageEffectName>
            <DamagedSound>ParticleElectrical</DamagedSound>

            <!-- Safezone info -->
            <MaxSafeZoneRadius>500</MaxSafeZoneRadius>
            <MinSafeZoneRadius>300</MinSafeZoneRadius>
            <DefaultSafeZoneRadius>300</DefaultSafeZoneRadius>
            <SafeZoneActivationTimeS>120</SafeZoneActivationTimeS>
            <MaxSafeZonePowerDrainkW>750000</MaxSafeZonePowerDrainkW>
            <MinSafeZonePowerDrainkW>450000</MinSafeZonePowerDrainkW>
